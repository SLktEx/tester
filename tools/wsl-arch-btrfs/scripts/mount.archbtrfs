#!/bin/sh
# Called by WSL's synchronous mount -a before the Plan9 server opens "/".
set -eu
d=/var/lib/archbtrfs
[ -n "${WSL2_DISTRO_NAME:-}" ] || exit 0
[ "$WSL2_DISTRO_NAME" = "$(cat "$d/name")" ] || exit 1
[ -f "$(cat "$d/marker")" ] || exit 0
exec >>"$d/boot.log" 2>&1
date -Is
[ "$(findmnt -no FSTYPE /)" = ext4 ]
img="$d/arch.img"
[ -f "$img" ] && [ ! -L "$img" ]
[ "$(blkid -s UUID -o value "$img")" = "$(cat "$d/uuid")" ]
if ! grep -qw btrfs /proc/filesystems; then
    modules="/usr/lib/modules/$(uname -r)"
    mkdir -p "$modules"
    mount --bind "${WSL2_KERNEL_MODULES_MOUNT:?}" "$modules"
    if ! modprobe btrfs; then umount "$modules"; exit 1; fi
    umount "$modules"
fi
r="$d/root"
mount -o loop,subvol=@ "$img" "$r"
[ "$(findmnt -no UUID -T "$r")" = "$(cat "$d/uuid")" ]
cmp -s "$r/etc/archbtrfs-instance" "$d/instance"
[ -x "$r/usr/lib/systemd/systemd" ]
for p in /dev /sys /proc /run /init /mnt/c /wsl??????; do
    mountpoint -q "$p" || continue
    if [ -d "$p" ]; then mkdir -p "$r$p"; else touch "$r$p"; fi
    mount --rbind "$p" "$r$p"
done
cd "$r"
pivot_root . .bootstrap/old
cd /
echo "pivot completed"
